# ============================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ============================================
# 📋 INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o arquivo .env com suas credenciais reais
# 3. NUNCA faça commit do arquivo .env

# ============================================
# GATEWAY DE PAGAMENTO (Pagar.me)
# ============================================
# Obtenha em: https://dash.pagar.me/

# TESTE (Para desenvolvimento local)
# VUE_APP_PAGARME_PUBLIC_KEY=TEST-sua-public-key-aqui

# PRODUÇÃO (Descomente para produção)
# VUE_APP_PAGARME_PUBLIC_KEY=sua-public-key-aqui

# ============================================
# CONFIGURAÇÕES DA API
# ============================================
VUE_APP_API_BASE_URL=

# ============================================
# MODO DEBUG
# ============================================
VUE_APP_DEBUG_MODE=true

# ============================================
# GOOGLE ANALYTICS 4
# ============================================
# Obtenha em: https://analytics.google.com → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
VUE_APP_GA_ID=G-14NXXWKZJX

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=development
