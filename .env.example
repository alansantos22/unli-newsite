# ============================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ============================================
# 📋 INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o arquivo .env com suas credenciais reais
# 3. NUNCA faça commit do arquivo .env

# ============================================
# MERCADO PAGO - PUBLIC KEY
# ============================================
# Obtenha em: https://www.mercadopago.com.br/developers/panel/credentials

# TESTE (Para desenvolvimento local)
VUE_APP_MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key-aqui

# PRODUÇÃO (Descomente para produção)
# VUE_APP_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui

# ============================================
# CONFIGURAÇÕES DA API
# ============================================
VUE_APP_API_BASE_URL=

# ============================================
# MODO DEBUG
# ============================================
VUE_APP_DEBUG_MODE=true

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=development
