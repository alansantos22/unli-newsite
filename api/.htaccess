# ============================================
# PROTEÇÃO DE ARQUIVOS SENSÍVEIS - API
# Apache 2.4+ (.htaccess)
# ============================================

# Desabilita listagem de diretórios
Options -Indexes

# IMPORTANTE: Garante que o diretório não é bloqueado por herança
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# Bloqueia acesso a arquivos ocultos (.env, .git, etc)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloqueia arquivos de configuração sensíveis
<FilesMatch "^(config\.secure\.php|db\.config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloqueia arquivos de log
<FilesMatch "\.(log|txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# Proteção contra injeção de código
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Bloqueia acesso a arquivos de configuração via padrão
  RewriteRule ^config\..*\.php$ - [F,L]
  
  # Bloqueia acesso direto a includes/lib/onboarding
  RewriteRule ^(lib|includes|onboarding)/.*$ - [F,L]
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# Limite de tamanho de requisição (10MB)
LimitRequestBody 10485760

# Timeout de conexão
<IfModule mod_reqtimeout.c>
  RequestReadTimeout header=20-40,MinRate=500 body=20-40,MinRate=500
</IfModule>

